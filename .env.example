# Copy to .env.local and fill in. Variables prefixed with VITE_ are bundled into the client build,
# so only use keys that are safe to expose (restrict them by HTTP referrer where the provider allows it).

# Required. TMDB "API Read Access Token" (v4 bearer): https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=

# Optional. Enables the full Music catalogue (latest uploads from official label channels + search).
# Create a YouTube Data API v3 key in Google Cloud Console and restrict it to your site's referrer.
VITE_YOUTUBE_API_KEY=

# Optional. Enables live cricket scores (free tier at https://www.cricketdata.org). Without it,
# fixtures/results come from TheSportsDB's free test key, which has very limited coverage.
VITE_CRICAPI_KEY=

# Optional. TheSportsDB key (the public test key is used when empty).
VITE_SPORTSDB_KEY=

# Optional. Location of the licensed-content manifest (defaults to /catalog.json).
VITE_CATALOG_URL=

# Optional. ISO-3166 region used for "where to watch" lookups (defaults to IN).
VITE_DEFAULT_REGION=IN
